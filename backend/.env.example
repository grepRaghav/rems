# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=rems-secret-academic-project-key-2026

# Oracle Database 11g Connection Configuration
# Primary driver: pyodbc with System DSN or direct Oracle ODBC Driver
ORACLE_DSN=REMS_DSN
ORACLE_DRIVER=Oracle in XE
ORACLE_HOST=127.0.0.1
ORACLE_PORT=1521
ORACLE_SERVICE=XE
ORACLE_USER=rems_user
ORACLE_PASSWORD=rems_password

# Connection Mode:
# 'odbc' = connects via pyodbc (Oracle ODBC Driver)
# 'auto' = attempts pyodbc/oracledb, falls back to dev SQLite if Oracle unreachable
DB_CONNECTION_MODE=auto

# Security & Session
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_SAMESITE=Lax
